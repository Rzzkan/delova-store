# ───────── Situs ─────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nomor WhatsApp admin untuk checkout (format internasional tanpa +)
NEXT_PUBLIC_WA_NUMBER=6281234567890

# ───────── Admin ─────────
ADMIN_PASSWORD=ganti-password-kuat
SESSION_SECRET=isi-string-acak-panjang
# Dipakai Vercel Cron untuk memanggil /api/shopee/sync
CRON_SECRET=isi-string-acak-lain

# ───────── Database ─────────
# Lokal: kosongkan (otomatis file data/delova.db)
# Produksi (Vercel): buat DB gratis di https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ───────── Shopee Open Platform ─────────
# Kosongkan SHOPEE_PARTNER_ID/KEY untuk MODE DEMO (data contoh, tanpa API)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# live | test (sandbox)
SHOPEE_ENV=live
# Harus sama persis dengan Redirect URL yang didaftarkan di Shopee Open Platform
SHOPEE_REDIRECT_URL=http://localhost:3000/api/shopee/callback
# Opsional: Live Push key & URL webhook (kalau beda dari partner key)
SHOPEE_PUSH_KEY=
SHOPEE_WEBHOOK_URL=

# ───────── Pixel iklan (opsional) ─────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# SEO: isi dengan domain publik (https) dan kode verifikasi Google Search Console
NEXT_PUBLIC_GSC_VERIFICATION=
